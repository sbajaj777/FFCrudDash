# Copy this file to .env and fill the values. Keep .env out of version control.
# EIA (U.S. Energy Information Administration) - get a free key at https://www.eia.gov/opendata/register.php
EIA_API_KEY=YOUR_EIA_API_KEY
# Comma-separated EIA series IDs to poll, e.g. PET.WCESTUS1.W,PET.RWTC.D
EIA_SERIES=PET.WCESTUS1.W,PET.RWTC.D

# Optional: AlphaVantage (fallback for prices) - https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_KEY=YOUR_ALPHAVANTAGE_KEY

# Optional: NewsAPI (if you prefer NewsAPI over Google News RSS) - https://newsapi.org/
NEWSAPI_KEY=YOUR_NEWSAPI_KEY

# Server port (default 4000)
PORT=4000
